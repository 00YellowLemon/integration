# ==============================================================================
# Gmail AI Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in the actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# Create these in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized Redirect URI: http://localhost:8000/auth/callback
# 4. Enable the Gmail API (https://console.cloud.google.com/apis/library/gmail.googleapis.com)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ------------------------------------------------------------------------------
# Application Security
# 32-byte secret key (hex-encoded) for AES-GCM token encryption and HMAC CSRF states.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# Connection string using asyncpg driver:
# Example: postgresql+asyncpg://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@your-supabase-host:5432/postgres

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Google Cloud Pub/Sub Configuration (Optional - auto-discovered via gcloud ADC)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_NAME=gmail-notifications
PUBSUB_SUBSCRIPTION_NAME=gmail-notifications-sub

# ------------------------------------------------------------------------------
# Gemini via Vertex AI (ADC) — LangChain Email Triage Agent (Phase 3)
# NO GOOGLE_API_KEY is used. The triage agent authenticates through Vertex AI
# using Application Default Credentials from `gcloud auth application-default login`.
#
# One-time GCP setup (manual, in your terminal):
#   gcloud config set project <PROJECT_ID>
#   gcloud services enable aiplatform.googleapis.com --project <PROJECT_ID>
#   gcloud projects add-iam-policy-binding <PROJECT_ID> \
#     --member="user:<you>@example.com" --role="roles/aiplatform.user"
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <PROJECT_ID>
#
# Do NOT set GOOGLE_API_KEY here; if it exists in your environment, remove it
# so the SDK cannot silently fall back to the Gemini Developer API.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
TRIAGE_ENABLED=true
TRIAGE_MODEL=gemini-3.8-flash
TRIAGE_TEMPERATURE=0.1
# Guardrails
TRIAGE_MAX_BODY_CHARS=12000
TRIAGE_MAX_MESSAGES_PER_THREAD=10
TRIAGE_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Phase 4: Resilience & Rate Limiting Guardrails
# Exponential backoff with jitter settings for Gmail REST API (429/503)
# and Gemini Vertex AI quota limits.
# ------------------------------------------------------------------------------
GMAIL_RATE_LIMIT_RETRIES=4
GMAIL_RETRY_BACKOFF_MIN=1.0
GMAIL_RETRY_BACKOFF_MAX=30.0
GEMINI_RATE_LIMIT_RETRIES=3


